# --- Serveur ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
TZ=Europe/Paris
LOG_LEVEL=info

# Base SQLite. Dans Docker, ce chemin pointe vers le volume persistant.
DATABASE_PATH=/data/todo.db

# Racine des fichiers statiques de la PWA servis par l'API.
WEB_DIST_PATH=/app/web

# --- Sécurité --------------------------------------------------------------
# Mot de passe unique de l'interface web. S'il est vide, l'API est ouverte à
# tout ce qui peut l'atteindre sur le réseau : acceptable derrière un VPN,
# à proscrire dès que le service est exposé.
APP_PASSWORD=
# Secret de signature du cookie de session (générer une valeur aléatoire).
SESSION_SECRET=changez-moi

# Origines autorisées en CORS pour les intégrations (AyLabs). Vide = aucune,
# la PWA étant servie par la même origine que l'API.
CORS_ORIGINS=

# --- Notifications et pastille iOS -----------------------------------------
# Générer la paire avec : npm run vapid -w @todo/api
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:todo@localhost

# Heure du résumé quotidien qui rafraîchit la pastille (format cron).
DAILY_DIGEST_CRON=0 7 * * *
